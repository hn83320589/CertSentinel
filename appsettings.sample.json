// CertSentinel 範例設定檔
// install-service.ps1 首次安裝時會複製到 %ProgramData%\CertSentinel\appsettings.json,
// 請編輯該檔(而非安裝目錄中的檔案),升級時不會被覆蓋。.NET 設定檔允許 // 註解。
{
  "CertSentinel": {
    // 資料庫位置,服務與 CLI 共用;支援 %環境變數%
    "DatabasePath": "%ProgramData%\\CertSentinel\\certsentinel.db",

    // 檢查間隔(分鐘)。服務啟動後立即檢查一輪,之後依此間隔重複;上一輪未完成不會開始下一輪
    "CheckIntervalMinutes": 360,

    // 同時檢查的目標數上限
    "MaxConcurrency": 5,

    // 剩餘天數 ≤ WarningDays 為 Warning;≤ CriticalDays 為 Critical(需 0 ≤ CriticalDays < WarningDays)
    "WarningDays": 30,
    "CriticalDays": 7,

    // 檢查歷史保留天數;每個目標最新一筆與通知進度永遠保留
    "RetentionDays": 90,

    // 連續幾次無法檢查才寄通知
    "ErrorNotifyThreshold": 3,

    // Critical / Expired / Error 持續期間的重新提醒間隔(小時)
    "ReminderIntervalHours": 24,

    "Smtp": {
      "Host": "smtp.example.com",
      "Port": 587,
      // None:不加密(僅限內網);StartTls:587 埠常用;SslOnConnect:465 埠常用
      "Security": "StartTls",
      // UserName 留空代表不驗證
      "UserName": "certsentinel@example.com",
      // 建議改用環境變數 CertSentinel__Smtp__Password(系統層級)提供,避免明文寫在檔案
      "Password": "",
      "From": "certsentinel@example.com",
      "To": [ "ops@example.com" ],
      "TimeoutSeconds": 30
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    // 日誌寫入事件檢視器 → Windows 記錄 → 應用程式,來源「CertSentinel」
    "EventLog": {
      "SourceName": "CertSentinel",
      "LogName": "Application",
      "LogLevel": {
        "Default": "Information",
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  }
}
