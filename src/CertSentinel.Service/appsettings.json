{
  "CertSentinel": {
    "DatabasePath": "%ProgramData%\\CertSentinel\\certsentinel.db",
    "CheckIntervalMinutes": 360,
    "MaxConcurrency": 5,
    "WarningDays": 30,
    "CriticalDays": 7,
    "RetentionDays": 90,
    "ErrorNotifyThreshold": 3,
    "ReminderIntervalHours": 24,
    "Smtp": {
      "Host": "",
      "Port": 587,
      "Security": "StartTls",
      "UserName": "",
      "Password": "",
      "From": "",
      "To": [],
      "TimeoutSeconds": 30
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "EventLog": {
      "LogLevel": {
        "Default": "Information",
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  }
}
